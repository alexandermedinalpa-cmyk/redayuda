# Imagen del webhook de WhatsApp (FastAPI). Recibe de Evolution API y responde.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ALERTAS_DB=/data/alertas_wa.json

WORKDIR /app

RUN pip install --no-cache-dir "fastapi[standard]==0.138.1"

COPY integraciones ./integraciones

RUN mkdir -p /data \
    && useradd --system --uid 10001 appuser \
    && chown -R appuser:appuser /app /data
USER appuser

EXPOSE 8000

CMD ["uvicorn", "integraciones.whatsapp_buscador.app:app", "--host", "0.0.0.0", "--port", "8000"]
